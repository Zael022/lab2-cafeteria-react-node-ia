# Copiá este archivo como .env (opcional: sin .env se usan estos valores).
# En Vite, solo las variables que empiezan con VITE_ llegan al navegador.

# Dirección de la API (backend)
VITE_API_URL=http://localhost:3000/api

# Webhook del workflow de n8n (asistente de compras)
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/sugerencia-compra

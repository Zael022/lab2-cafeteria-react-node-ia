# Copiá este archivo como .env (es opcional: sin .env se usan estos
# mismos valores por defecto). El .env NO se sube al repositorio.

# Archivo de la base de datos SQLite (relativo a la carpeta backend)
DB_FILE=cafeteria.db

# Puerto de la API
PORT=3000

# Origen del front (Vite usa el 5173 por defecto)
CORS_ORIGIN=http://localhost:5173

# Copiá este archivo como .env y ajustá DATABASE_URL a tu PostgreSQL.
# El .env NO se sube al repositorio (está en .gitignore).

# postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
#
# Con el docker-compose.yml de este repo (puerto 5433):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cafeteria
#
# Con un PostgreSQL propio en el puerto 5432 (cambiá usuario y contraseña):
# DATABASE_URL=postgresql://TU_USUARIO:TU_CONTRASEÑA@localhost:5432/cafeteria

# Puerto de la API
PORT=3000

# Origen del front (Vite usa el 5173 por defecto)
CORS_ORIGIN=http://localhost:5173

# Zona horaria del negocio: define qué es "hoy" para el cierre de caja
TIMEZONE=America/Costa_Rica
